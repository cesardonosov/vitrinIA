# Copiar a .env.local y completar. Nunca poner valores reales aquí.
# Formato de cada línea de comentario: tipo · consumidor · rotación

# no secreta · app+worker · development | test | staging | production
APP_ENV=

# secreta · app+worker · URL postgres:// de la base
DATABASE_URL=

# secreta · app+worker · mínimo 32 caracteres · rotación 90 d
SESSION_SECRET=

# no secreta · app+worker · fatal | error | warn | info | debug | trace (por defecto info)
LOG_LEVEL=
