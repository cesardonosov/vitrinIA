# Copiar a .env.local y completar. Nunca poner valores reales aquí.
# Formato de cada línea de comentario: tipo · consumidor · rotación

# no secreta · app+worker · development | test | staging | production
APP_ENV=

# secreta · app+worker · URL postgres:// de la base. Fuera de Docker es SIEMPRE la URL de app_user; nunca el superusuario (vitrinia_admin) ni migrator
DATABASE_URL=

# secreta · app+worker · mínimo 32 caracteres · rotación 90 d
SESSION_SECRET=

# no secreta · app+worker · fatal | error | warn | info | debug | trace (por defecto info)
LOG_LEVEL=

# secreta · solo docker compose (postgres) · superusuario de arranque, solo administración · hex/alfanumérica (va en URLs)
POSTGRES_ADMIN_PASSWORD=

# secreta · solo docker compose (postgres, migrate) · rol dueño de las tablas, solo lo usa `migrate` · hex/alfanumérica
MIGRATOR_PASSWORD=

# secreta · solo docker compose (postgres, app, worker) · rol app_user sin BYPASSRLS · hex/alfanumérica
APP_USER_PASSWORD=

# no secreta (pública, va al navegador) · app · site key de Cloudflare Turnstile del checkout. Obligatoria en staging y production; en development/test se usa la clave de prueba pública de Cloudflare
TURNSTILE_SITE_KEY=

# secreta · app · secret key de Cloudflare Turnstile (verificación en el servidor) · obligatoria en staging y production, que rechazan la clave de prueba · rotación 90 d
TURNSTILE_SECRET_KEY=

# no secreta · solo development/test · URL alternativa de siteverify para el E2E (servidor falso local). Prohibida en staging y production; dejar vacía
TURNSTILE_VERIFY_URL=
