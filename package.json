{
  "name": "vitrinia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install",
    "dev:up": "docker compose --env-file .env.local up -d --build --wait",
    "dev:down": "docker compose --env-file .env.local down",
    "semgrep:test": "semgrep --metrics=off --test .semgrep/rules",
    "todo-check": "TODO_CHECK_OFFLINE=1 bash infra/ci/check-todos.sh",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.33.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "lefthook": "^2.2.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
