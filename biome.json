{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "plugins": ["./biome/no-hardcoded-design-values.grit"],
  "files": {
    "includes": [
      "**",
      "!src/shared/design/tokens.css",
      "!**/.semgrep/rules/vitrinia.ts",
      "!**/.semgrep/rules/vitrinia.tsx"
    ]
  }
}
